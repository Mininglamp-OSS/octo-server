{
  "name": "@octo/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight resident HTTP runtime embedding the pi coding-agent kernel (Fastify + Bearer auth + verbose projection + SSE replay).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.2.1"
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "x-octo-constraints": {
    "aggregateArrayLimits": [
      {
        "parentArray": "missing",
        "childArray": "items",
        "maxTotalItems": 2
      }
    ]
  },
  "required": ["title", "groups"],
  "properties": {
    "title": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
